<?xml version="1.0" encoding="UTF-8"?>
<!-- Seal build settings: route every repository the 2018 poms declare to HTTPS
     Maven Central, except jenkins-ci, which hosts the org.jenkins-ci:jenkins
     parent pom chain of jetty-version-maven-plugin (not on Central). -->
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0 http://maven.apache.org/xsd/settings-1.0.0.xsd">
  <mirrors>
    <mirror>
      <id>central-https</id>
      <mirrorOf>*,!jenkins-ci</mirrorOf>
      <url>https://repo.maven.apache.org/maven2</url>
    </mirror>
  </mirrors>
  <profiles>
    <profile>
      <id>jenkins-ci</id>
      <activation>
        <activeByDefault>true</activeByDefault>
      </activation>
      <repositories>
        <repository>
          <id>jenkins-ci</id>
          <url>https://repo.jenkins-ci.org/public/</url>
          <snapshots><enabled>false</enabled></snapshots>
        </repository>
      </repositories>
      <pluginRepositories>
        <pluginRepository>
          <id>jenkins-ci</id>
          <url>https://repo.jenkins-ci.org/public/</url>
          <snapshots><enabled>false</enabled></snapshots>
        </pluginRepository>
      </pluginRepositories>
    </profile>
  </profiles>
</settings>
